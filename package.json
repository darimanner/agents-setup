{
  "name": "agents-setup",
  "version": "0.0.0",
  "description": "One agent-neutral config for every coding agent: rules, skills, MCP servers, hooks and plugins, scoped per folder",
  "keywords": [
    "agents",
    "ai",
    "claude-code",
    "codex",
    "opencode",
    "hermes",
    "mcp",
    "skills",
    "agents-md",
    "cli"
  ],
  "license": "MIT",
  "author": "Kostiantyn Durlov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darimanner/agents-setup.git"
  },
  "homepage": "https://github.com/darimanner/agents-setup#readme",
  "bugs": "https://github.com/darimanner/agents-setup/issues",
  "type": "module",
  "bin": {
    "agents-setup": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
